---
const year = new Date().getFullYear()

import SocialLinks from '@/components/social-links.astro'
---

<footer class="border-t border-border">
  <div class="mx-auto flex min-h-[110px] w-full max-w-[1020px] items-center justify-between gap-8 px-6 max-[680px]:flex-col max-[680px]:items-center max-[680px]:gap-4 max-[680px]:px-4 max-[680px]:py-7">
    <p class="m-0 text-sm text-muted-foreground max-[680px]:text-center">© {year} Manuel Bernabé Rodríguez <span class="opacity-70">· elmanueh</span></p>
    <SocialLinks compact />
  </div>
</footer>
