---
const links = [
  { href: '/#inicio', label: 'Inicio' },
  { href: '/#proyectos', label: 'Proyectos' }
]
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 w-full max-w-[1020px] items-center justify-between px-6 max-[680px]:px-4">
    <a href="/" class="inline-flex items-center gap-2.5 text-sm font-semibold tracking-tight text-foreground no-underline" aria-label="elmanueh — Inicio">
      <span class="size-[30px] bg-brand [mask-image:url('/favicon.svg')] [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain]" aria-hidden="true"></span>
      <span>elmanueh</span>
    </a>

    <nav class="max-[820px]:hidden" aria-label="Navegación principal">
      <ul class="m-0 flex list-none gap-6 p-0">
        {links.map(({ href, label }) => <li><a class="text-[.84rem] text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground" href={href}>{label}</a></li>)}
      </ul>
    </nav>

  </div>
</header>
