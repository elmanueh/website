---
import { I18n } from '@/i18n'
import LanguageSwitcher from '@/components/language-switcher.astro'
import type { FragmentTranslations } from '@/i18n/types'

interface Props {
  fragmentTranslations?: FragmentTranslations
}

const { fragmentTranslations } = Astro.props

const i18n = I18n.from(Astro)
const { t } = i18n
const homeHref = i18n.path()
const links = [
  { href: `${homeHref}#${t.anchors.home}`, label: t.header.home },
  { href: `${homeHref}#${t.anchors.projects}`, label: t.header.projects }
]
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 w-full max-w-255 items-center justify-between px-6 max-[680px]:px-4">
    <a href={homeHref} class="inline-flex items-center gap-2.5 text-sm font-semibold tracking-tight text-foreground no-underline" aria-label={t.header.homeAria}>
      <span class="size-7.5 bg-brand mask-[url('/favicon.svg')] mask-center mask-no-repeat mask-contain" aria-hidden="true"></span>
      <span>elmanueh</span>
    </a>

    <div class="flex items-center gap-8">
      <nav class="max-[820px]:hidden" aria-label={t.header.navigationAria}>
        <ul class="m-0 flex list-none gap-6 p-0">
          {links.map(({ href, label }) => <li><a class="text-[.84rem] text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground" href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <LanguageSwitcher fragmentTranslations={fragmentTranslations} />
    </div>
  </div>
</header>
