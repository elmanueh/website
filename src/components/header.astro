---
import { projects } from '@/data/projects'

const isExternalUrl = (href: string) => /^https?:\/\//.test(href)
---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/favicon.svg"
        width="26"
        height="26"
        alt="Logo"
        class="opacity-90"
      />
      <span class="text-sm font-medium tracking-tight">elmanueh</span>
    </a>

    <nav aria-label="Accesos directos a proyectos">
      <ul class="flex items-center gap-1 sm:gap-3">
        {
          projects.map(({ href, image, icon, title }) => {
            const external = isExternalUrl(href)
            const headerImage = icon ?? image

            return (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noreferrer' : undefined}
                  aria-label={`Abrir ${title}`}
                  title={title}
                  class="flex size-7 items-center justify-center overflow-hidden rounded-full border border-border/60 bg-background/70 transition hover:border-border hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none sm:size-8"
                >
                  <img
                    src={headerImage.src}
                    width="24"
                    height="24"
                    alt=""
                    class="size-full object-cover opacity-85 transition-opacity hover:opacity-100"
                  />
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</header>
