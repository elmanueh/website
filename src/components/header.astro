---
import { I18n } from '@/i18n'

const i18n = I18n.from(Astro)
const { locale, t, equivalentPath } = i18n
const homeHref = i18n.path()
const links = [
  { href: `${homeHref}#inicio`, label: t.header.home },
  { href: `${homeHref}#proyectos`, label: t.header.projects }
]
const languageLinks = i18n.languageLinks()
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 w-full max-w-[1020px] items-center justify-between px-6 max-[680px]:px-4">
    <a href={homeHref} class="inline-flex items-center gap-2.5 text-sm font-semibold tracking-tight text-foreground no-underline" aria-label={t.header.homeAria}>
      <span class="size-[30px] bg-brand [mask-image:url('/favicon.svg')] [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain]" aria-hidden="true"></span>
      <span>elmanueh</span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="max-[820px]:hidden" aria-label={t.header.navigationAria}>
        <ul class="m-0 flex list-none gap-6 p-0">
          {links.map(({ href, label }) => <li><a class="text-[.84rem] text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground" href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label={t.header.languageSelectorAria}>
        <ul class="m-0 flex list-none items-center gap-1 p-0 font-mono text-xs font-semibold">
          {languageLinks.map((link, index) => (
            <li class="flex items-center gap-1">
              {index > 0 && <span class="text-border" aria-hidden="true">/</span>}
              <a
                href={link.href}
                data-language-link
                data-preserve-fragment={equivalentPath === '' ? 'true' : undefined}
                class:list={['rounded px-1.5 py-1 no-underline outline-none transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-ring', link.locale === locale ? 'text-brand' : 'text-muted-foreground hover:text-foreground']}
                aria-current={link.locale === locale ? 'page' : undefined}
                aria-label={link.label}
                lang={link.locale}
                hreflang={link.locale}
              >{link.locale.toUpperCase()}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const fragment = window.location.hash
  if (fragment) {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link][data-preserve-fragment="true"]').forEach((link) => {
      link.href = `${link.href.split('#')[0]}${fragment}`
    })
  }
</script>
