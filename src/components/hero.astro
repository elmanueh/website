---
import ProfileImage from '@/assets/profile.png'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import SocialLinks from '@/components/social-links.astro'
import { profile } from '@/data/profile'
---

<section id="inicio" class="grid grid-cols-[minmax(0,1.4fr)_minmax(280px,.6fr)] items-center gap-12 py-20 max-[820px]:grid-cols-1 max-[820px]:gap-10 max-[680px]:py-14" aria-labelledby="hero-title">
  <div class="min-w-0 text-left max-[820px]:order-2">
    <p class="m-0 mb-5 flex items-center gap-2 text-sm text-muted-foreground">
      <Icon name="lucide:map-pin" size={16} aria-hidden="true" />
      {profile.location}
    </p>

    <h1 id="hero-title" class="m-0 mb-5 text-[clamp(3.25rem,6vw,5rem)] leading-[.98] font-semibold tracking-[-.06em] text-foreground max-[680px]:text-[clamp(3rem,14vw,4.25rem)]">
      <span class="block">Manuel Bernabé</span>
      <span class="block">Rodríguez</span>
    </h1>

    <p class="m-0 mb-4 text-[clamp(1.1rem,2vw,1.35rem)] font-semibold text-brand">{profile.role}</p>
    <p class="m-0 mb-8 max-w-[650px] text-base leading-relaxed text-muted-foreground">
      {profile.summary} Mi stack principal es <strong class="font-semibold text-foreground">{profile.stack.join(', ')}</strong>.
    </p>

    <div class="flex flex-wrap items-center gap-3">
      <SocialLinks />
      <a class="inline-flex min-h-10 items-center justify-center gap-2 rounded-[9px] border border-border bg-card px-4 py-2 text-sm font-semibold text-foreground no-underline transition-colors duration-200 hover:bg-muted" href={profile.cvUrl} target="_blank" rel="noopener">
        Descargar CV
        <Icon name="lucide:download" size={17} aria-hidden="true" />
      </a>
    </div>
  </div>

  <aside class="w-full max-w-[340px] justify-self-end overflow-hidden rounded-xl border border-border bg-card max-[820px]:order-1 max-[820px]:max-w-[132px] max-[820px]:justify-self-start" aria-label="Perfil de Manuel Bernabé Rodríguez">
    <Image src={ProfileImage} alt="Retrato de Manuel Bernabé Rodríguez" widths={[160, 320, 480, 640]} sizes="(max-width: 820px) 132px, 340px" class="aspect-square w-full object-cover" loading="eager" quality={88} />
    <div class="p-5 max-[820px]:hidden">
      <p class="m-0 mb-2 font-mono text-[.7rem] font-semibold tracking-[.13em] text-brand uppercase">Enfoque</p>
      <h2 class="m-0 mb-2 text-lg leading-tight font-semibold tracking-[-.02em] text-foreground">Backend y arquitectura</h2>
      <p class="m-0 text-sm text-muted-foreground">Servicios mantenibles, integración entre sistemas y automatización del ciclo de entrega.</p>
    </div>
  </aside>
</section>
