---
import { I18n } from '@/i18n'
const i18n = I18n.from(Astro)
const { locale, t } = i18n
const languageLinks = i18n.languageLinks()
---

<nav class="rounded-md bg-muted/70 px-1 py-0.5" aria-label={t.header.languageSelectorAria}>
  <ul class="m-0 flex list-none items-center gap-1 p-0 font-mono text-xs font-semibold">
    {languageLinks.map((link, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && <span class="text-border" aria-hidden="true">/</span>}
        <a
          href={link.href}
          data-language-link
          data-astro-reload
          class:list={['rounded px-1.5 py-1 no-underline outline-none transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-ring', link.locale === locale ? 'text-brand' : 'text-muted-foreground hover:text-foreground']}
          aria-current={link.locale === locale ? 'page' : undefined}
          aria-label={link.label}
          lang={link.locale}
          hreflang={link.locale}
        >{link.locale.toUpperCase()}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function updateLanguageLinks() {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      const url = new URL(link.href)
      url.search = window.location.search
      url.hash = ''
      link.href = url.href
    })
  }

  updateLanguageLinks()
  document.addEventListener('astro:page-load', updateLanguageLinks)
  document.addEventListener('click', updateLanguageLinks, { capture: true })
</script>
