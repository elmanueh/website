---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import type { Project } from '@/types/project'
import GithubButton from '@/components/projects/github-button'
import { I18n } from '@/i18n'

interface Props {
  project: Project
}

const { project } = Astro.props
const i18n = I18n.from(Astro)
const { locale, t } = i18n
const projectHref = i18n.path(`projects/${project.slug}`)
const localizeHref = (href: string) => {
  if (/^https?:\/\//.test(href)) return href
  const [path, fragment] = href.split('#', 2)
  return `${i18n.path(path)}${fragment ? `#${fragment}` : ''}`
}
interface ProjectAction {
  href: string
  label: string
  icon: string
  external: boolean
}
const actions: ProjectAction[] = []
if (project.appUrl) actions.push({ href: localizeHref(project.appUrl), label: t.projects.linkLabels.app, icon: 'lucide:app-window', external: /^https?:\/\//.test(project.appUrl) })
---

<article class="group relative grid h-57.5 grid-cols-[minmax(0,34fr)_minmax(0,66fr)] gap-5 overflow-hidden rounded-xl border border-border bg-card p-4 transition-[border-color,background-color,box-shadow] duration-300 hover:border-ring hover:bg-muted hover:shadow-[0_14px_34px_rgb(0_0_0/.18)] focus-within:border-ring focus-within:ring-2 focus-within:ring-ring motion-reduce:transition-none max-[680px]:h-auto max-[680px]:grid-cols-1">
  <a class="absolute inset-0 z-10 rounded-xl focus-visible:outline-none" href={projectHref} aria-label={`${t.projectDetail.openCaseStudy} ${project.title}`}><span class="sr-only">{t.projectDetail.openCaseStudy} {project.title}</span></a>
  <div class="h-full min-h-0 overflow-hidden rounded-lg bg-background max-[680px]:h-auto max-[680px]:aspect-video">
    <Image
      transition:name={`project-image-${locale}-${project.slug}`}
      src={project.image}
      alt={`${t.projects.previewAlt} ${project.title}`}
      widths={[360, 560, 760]}
      sizes="(max-width: 680px) calc(100vw - 3rem), 320px"
      class="h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.035] group-focus-within:scale-[1.035] motion-reduce:transform-none motion-reduce:transition-none"
      loading="lazy"
      quality={85}
    />
  </div>

  <div class="flex min-w-0 flex-col items-start py-1 pr-1 max-[680px]:p-1">
    <div>
      <p class="m-0 mb-2 font-mono text-[.7rem] font-semibold tracking-[.13em] text-brand uppercase">{t.projects.cardEyebrow}</p>
      <h3 transition:name={`project-title-${locale}-${project.slug}`} class="m-0 mb-2 text-[1.35rem] leading-tight font-semibold tracking-[-.03em] text-foreground transition-colors duration-200 group-hover:text-brand">
        {project.title}
      </h3>
      <p transition:name={`project-description-${locale}-${project.slug}`} class="m-0 text-sm leading-relaxed text-muted-foreground">{project.subtitle}</p>
    </div>

    <div class="mt-auto flex w-full items-end justify-between gap-4 pt-4">
      <ul transition:name={`project-tags-${locale}-${project.slug}`} class="m-0 flex min-w-0 list-none flex-wrap gap-1.5 p-0" aria-label={`${t.projects.technologiesLabel} ${project.title}`}>
        {project.tags.map((tag) => <li class="rounded-md border border-border bg-background px-2 py-1 font-mono text-[.69rem] leading-snug text-muted-foreground">{tag}</li>)}
      </ul>

      <div class="relative z-20 flex shrink-0 items-center gap-2">
        {project.repository && (
          <GithubButton
            client:load
            slug={project.slug}
            aria-label={t.projects.linkLabels.source}
            title={t.projects.linkLabels.source}
            className="inline-flex size-9 items-center justify-center rounded-full border border-border text-muted-foreground no-underline transition-colors duration-200 hover:border-ring hover:bg-card hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            <Icon name="simple-icons:github" is:inline size={16} aria-hidden="true" />
          </GithubButton>
        )}
        {actions.map((action) => (
          <a
            class="inline-flex size-9 items-center justify-center rounded-full border border-border text-muted-foreground no-underline transition-colors duration-200 hover:border-ring hover:bg-card hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            href={action.href}
            target={action.external ? '_blank' : undefined}
            rel={action.external ? 'noopener noreferrer' : undefined}
            aria-label={action.label}
            title={action.label}
          >
            <Icon name={action.icon} size={16} aria-hidden="true" />
          </a>
        ))}
        <a
          class="inline-flex size-9 items-center justify-center text-brand no-underline transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-focus-within:translate-x-1 group-focus-within:-translate-y-1 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring motion-reduce:transform-none motion-reduce:transition-none"
          href={projectHref}
          aria-label={`${t.projectDetail.openCaseStudy} ${project.title}`}
          title={`${t.projectDetail.openCaseStudy} ${project.title}`}
        >
          <Icon name="lucide:arrow-up-right" size={17} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</article>
