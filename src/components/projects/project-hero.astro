---
import { Image } from 'astro:assets'
import ProjectMetadataCard from '@/components/projects/project-metadata-card.astro'
import type { Project } from '@/types/project'
import { I18n } from '@/i18n'

interface Props {
  project: Project
}

const { project } = Astro.props
const i18n = I18n.from(Astro)
const { locale, t } = i18n
const heroImage = project.icon ?? project.image
---

<header class="border-b border-border pb-10 max-[680px]:pb-8">
  <div class="grid grid-cols-[minmax(0,1fr)_112px] items-start gap-10 max-[680px]:grid-cols-1 max-[680px]:gap-5">
    <div class="min-w-0">
      <p class="m-0 mb-3 font-mono text-[.7rem] font-semibold tracking-[.13em] text-brand uppercase">{t.projectDetail.eyebrow}</p>
      <h1 transition:name={`project-title-${locale}-${project.slug}`} class="m-0 mb-4 text-[clamp(2.35rem,5vw,3.6rem)] leading-none font-semibold tracking-tighter text-foreground">{project.title}</h1>
      <p transition:name={`project-description-${locale}-${project.slug}`} class="m-0 mb-5 max-w-170 text-base leading-relaxed text-muted-foreground">{project.subtitle}</p>

      <ul transition:name={`project-tags-${locale}-${project.slug}`} class="m-0 mb-6 flex list-none flex-wrap gap-1.5 p-0" aria-label={`${t.projects.technologiesLabel} ${project.title}`}>
        {project.tags.map((tag) => <li class="rounded-md border border-border bg-background px-2.5 py-1 font-mono text-[.7rem] leading-snug text-muted-foreground">{tag}</li>)}
      </ul>

    </div>

    <div class="flex size-28 items-center justify-center justify-self-end max-[680px]:row-start-1 max-[680px]:size-20 max-[680px]:justify-self-start">
      <Image transition:name={`project-image-${locale}-${project.slug}`} src={heroImage} alt={`${t.projects.previewAlt} ${project.title}`} widths={[80, 112, 224]} sizes="(max-width: 680px) 80px, 112px" class="h-full w-full object-contain" loading="eager" quality={88} />
    </div>
  </div>

  <ProjectMetadataCard project={project} />
</header>
