---
import { Icon } from 'astro-icon/components'
import { I18n } from '@/i18n'

const { t } = I18n.from(Astro)
---

<dialog
  closedby="none"
  data-image-viewer
  data-enlarge-label={t.projectDetail.enlargeImage}
  aria-label={t.projectDetail.imagePreview}
  class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-transparent px-4 pt-16 pb-8 text-white backdrop:bg-black/60 backdrop:backdrop-blur-sm open:grid open:place-items-center sm:px-10"
>
  <button
    type="button"
    data-close-image
    aria-label={t.projectDetail.closeImage}
    class="absolute top-4 right-4 grid size-11 cursor-pointer place-items-center rounded-full border border-border bg-background text-muted-foreground transition-colors duration-200 hover:border-ring hover:bg-card hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring sm:right-10"
  >
    <Icon name="lucide:x" size={22} aria-hidden="true" />
  </button>
  <img
    data-preview-image
    alt=""
    class="block h-auto max-h-[calc(100dvh-7rem)] w-auto max-w-[min(120rem,100%)] rounded-lg"
  />
</dialog>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-image-viewer]')
    const content = dialog?.closest('main')?.querySelector<HTMLElement>('.case-study-sections')
    const preview = dialog?.querySelector<HTMLImageElement>('[data-preview-image]')
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-close-image]')
    if (!dialog || !content || !preview || !closeButton || dialog.dataset.initialized) return
    dialog.dataset.initialized = 'true'

    const events = new AbortController()
    const options = { signal: events.signal }
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    let selection: { image: HTMLImageElement; button: HTMLButtonElement } | undefined
    let previousOverflow = ''
    let busy = false
    let closeRequested = false
    let transition: ViewTransition | undefined

    const setOpen = async (open: boolean): Promise<void> => {
      if (busy) {
        if (!open) closeRequested = true
        return
      }
      if (!selection || events.signal.aborted || open === dialog.open) return

      busy = true
      const { image, button } = selection
      const from = open ? image : preview
      const to = open ? preview : image
      const fromName = from.style.viewTransitionName
      const toName = to.style.viewTransitionName
      const update = () => {
        if (events.signal.aborted || open === dialog.open) return
        if (open) {
          previousOverflow = document.documentElement.style.overflow
          dialog.showModal()
          dialog.focus({ preventScroll: true })
          document.documentElement.style.overflow = 'hidden'
        } else {
          dialog.close()
          document.documentElement.style.overflow = previousOverflow
        }
      }

      try {
        if (open) await preview.decode().catch(() => {})
        if (events.signal.aborted) return

        if (document.startViewTransition && !reducedMotion.matches) {
          from.style.viewTransitionName = 'project-image-zoom'
          transition = document.startViewTransition(() => {
            from.style.viewTransitionName = fromName
            if (events.signal.aborted) return
            update()
            to.style.viewTransitionName = 'project-image-zoom'
          })
          void transition.ready.catch(() => {})
          await transition.finished
        } else update()
      } catch {
        // Keep the viewer usable if the browser cannot complete the animation.
        update()
      } finally {
        from.style.viewTransitionName = fromName
        to.style.viewTransitionName = toName
        transition = undefined
        busy = false
        if (!open) {
          preview.removeAttribute('src')
          selection = undefined
          if (!events.signal.aborted) button.focus({ preventScroll: true })
        }
        if (closeRequested) {
          closeRequested = false
          void setOpen(false)
        }
      }
    }

    for (const image of content.querySelectorAll<HTMLImageElement>('figure img')) {
      if (image.closest('a, button')) continue
      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'case-study-image-trigger'
      const width = Number(image.getAttribute('width')) || image.naturalWidth
      const height = Number(image.getAttribute('height')) || image.naturalHeight
      if (width > 0 && height > 0) button.style.aspectRatio = `${width} / ${height}`
      button.setAttribute('aria-label', `${dialog.dataset.enlargeLabel}: ${image.alt}`)
      button.setAttribute('aria-haspopup', 'dialog')
      const imageContent = image.closest('picture') ?? image
      imageContent.before(button)
      button.append(imageContent)

      button.addEventListener(
        'click',
        () => {
          if (busy || dialog.open) return
          selection = { image, button }
          preview.src = image.currentSrc || image.src
          preview.alt = image.alt
          preview.width = image.naturalWidth || image.width
          preview.height = image.naturalHeight || image.height
          void setOpen(true)
        },
        options
      )
    }

    closeButton.addEventListener('click', () => void setOpen(false), options)
    dialog.addEventListener('cancel', (event) => event.preventDefault(), options)
    document.addEventListener(
      'astro:before-swap',
      () => {
        events.abort()
        transition?.skipTransition()
        if (dialog.open) {
          dialog.close()
          document.documentElement.style.overflow = previousOverflow
        }
      },
      { once: true, ...options }
    )
  })
</script>

<style>
  :global(.case-study-sections .case-study-image-trigger) {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: transparent;
    cursor: zoom-in;
    contain: paint;
  }

  :global(.case-study-image-trigger picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.case-study-sections .case-study-image-trigger img) {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  :global(.case-study-image-trigger:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(.case-study-image-trigger:hover img) {
      transform: scale(1.05);
    }
  }

  :global(::view-transition-group(project-image-zoom)) {
    animation-duration: 350ms;
    animation-timing-function: ease;
  }
</style>
