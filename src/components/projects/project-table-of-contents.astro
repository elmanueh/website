---
import { I18n } from '@/i18n'

interface TocItem {
  slug: string
  text: string
}

interface Props {
  items: TocItem[]
}

const { items } = Astro.props
const { t } = I18n.from(Astro)
---

<aside class="max-[900px]:hidden">
  <nav class="sticky top-24" aria-label={t.projectDetail.onThisPage}>
    <p class="m-0 mb-4 font-mono text-[.68rem] font-semibold tracking-[.13em] text-muted-foreground uppercase">{t.projectDetail.onThisPage}</p>
    <ol class="m-0 list-none border-l border-border p-0">
      {items.map((item, index) => (
        <li>
          <a class="grid grid-cols-[1.6rem_1fr] items-baseline gap-2 border-l border-transparent py-2 pl-4 text-sm leading-5 text-muted-foreground no-underline transition-colors duration-200 hover:border-brand hover:text-foreground focus-visible:border-brand focus-visible:text-foreground focus-visible:outline-none" href={`#${item.slug}`}>
            <span class="font-mono text-[.7rem] leading-5 text-brand">{String(index + 1).padStart(2, '0')}</span>
            <span class="leading-5">{item.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
