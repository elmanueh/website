---
import { Icon } from 'astro-icon/components'
import ProjectHero from '@/components/projects/project-hero.astro'
import ProjectTableOfContents from '@/components/projects/project-table-of-contents.astro'
import type { Project } from '@/data/projects'
import { I18n } from '@/i18n'
import '@/styles/case-study.css'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  project: Project
  headings: Heading[]
}

const { project, headings } = Astro.props
const i18n = I18n.from(Astro)
const { t } = i18n
const tocItems = [{ slug: 'overview', text: t.projectDetail.overview }, ...headings.filter(({ depth }) => depth === 2)]
---

<main>
  <article class="mx-auto w-full max-w-255 px-6 py-12 max-[680px]:px-4 max-[680px]:py-6">
    <a class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={`${i18n.path()}#proyectos`}>
      <Icon name="lucide:arrow-left" size={16} aria-hidden="true" />
      {t.projectDetail.backToProjects}
    </a>

    <ProjectHero project={project} />

    <div class="mt-16 grid grid-cols-[180px_minmax(0,720px)] justify-center gap-18 max-[900px]:mt-12 max-[900px]:grid-cols-1">
      <ProjectTableOfContents items={tocItems} />

      <div class="case-study-sections min-w-0">
        <section aria-labelledby="overview">
          <h2 id="overview">{t.projectDetail.overview}</h2>
          <p>{project.subtitle}</p>
        </section>
        <slot />
      </div>
    </div>
  </article>
</main>
