---
import type { GetStaticPaths } from 'astro'
import { getProjectCaseStudy, getProjectSlugs } from '@/services/projects'
import { I18n } from '@/i18n'
import CaseStudyLayout from '@/layouts/case-study-layout.astro'
import Layout from '@/layouts/layout.astro'

export const getStaticPaths = (async () => (await getProjectSlugs()).flatMap((slug) => [
  { params: { locale: undefined, slug } },
  { params: { locale: 'en', slug } }
])) satisfies GetStaticPaths

const i18n = I18n.from(Astro)
const { locale } = i18n
const slug = Astro.params.slug ?? ''
const { project, Content, headings, fragmentTranslations } = await getProjectCaseStudy(slug, locale)
---

<Layout title={`${project.title} | elmanueh`} description={project.subtitle} fragmentTranslations={fragmentTranslations}>
  <CaseStudyLayout project={project} headings={headings}>
    <Content />
  </CaseStudyLayout>
</Layout>
