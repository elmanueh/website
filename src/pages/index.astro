---
import Hero from '@/components/hero.astro'
import ProjectCard from '@/components/project-card.astro'
import { projects } from '@/data/projects'
import Layout from '@/layouts/layout.astro'
---

<Layout>
  <main>
    <div class="mx-auto w-full max-w-[1020px] px-6 max-[680px]:px-4">
      <Hero />

      <section id="proyectos" class="border-t border-border py-28 max-[680px]:py-20" aria-labelledby="projects-title">
        <header class="mb-8 max-w-[680px]">
          <p class="m-0 mb-2 font-mono text-[.7rem] font-semibold tracking-[.13em] text-[#b8d47a] uppercase">Portfolio</p>
          <h2 id="projects-title" class="m-0 mb-3 text-[clamp(2rem,5vw,3.3rem)] leading-[1.12] font-semibold tracking-[-.035em] text-foreground">Proyectos</h2>
          <p class="m-0 text-muted-foreground">Trabajos académicos y personales centrados en backend, arquitectura, datos y aplicaciones web.</p>
        </header>

        <div class="flex flex-col gap-4">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    </div>
  </main>
</Layout>
